rules_version = '2';

// PawMatch privacy model
// - users/{uid}       public: username, city, rounded location. NO real name/phone/address.
// - private/{uid}     owner only, OR the other member of a chat where BOTH owners consented.
// - dogs/{uid}        public dog profile.
// - swipes/{a}_{b}    a liked/passed b. Visible only to a and b.
// - chats/{a}_{b}     created only after a mutual like; each member may change only their own consent.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function pairId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function chatPath(id) { return /databases/$(database)/documents/chats/$(id); }
    function swipePath(id) { return /databases/$(database)/documents/swipes/$(id); }
    function validUsername(u) { return u is string && u.matches('^[a-z0-9_.]{3,20}$'); }
    function inPair(id) { return id.split('_')[0] == me() || id.split('_')[1] == me(); }

    function bothConsented(other) {
      return exists(chatPath(pairId(me(), other)))
        && get(chatPath(pairId(me(), other))).data.consent[me()] == true
        && get(chatPath(pairId(me(), other))).data.consent[other] == true;
    }

    function otherOf(m) { return m[0] == me() ? m[1] : m[0]; }

    function likes(a, b) {
      return exists(swipePath(a + '_' + b)) && get(swipePath(a + '_' + b)).data.liked == true;
    }

    // ---------- usernames (uniqueness) ----------
    match /usernames/{username} {
      allow get: if signedIn();
      allow create: if signedIn()
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me();
      allow update, delete: if false;
    }

    // ---------- public user profile ----------
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['username', 'city', 'lat', 'lng', 'createdAt'])
        && validUsername(request.resource.data.username)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == me();
      allow update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['username', 'city', 'lat', 'lng', 'createdAt'])
        && request.resource.data.username == resource.data.username;
      allow delete: if false;
    }

    // ---------- private contact details ----------
    match /private/{uid} {
      allow read: if signedIn() && (uid == me() || bothConsented(uid));
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['realName', 'phone', 'address'])
        && request.resource.data.realName is string && request.resource.data.realName.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.address is string && request.resource.data.address.size() <= 200;
      allow delete: if signedIn() && uid == me();
    }

    // ---------- dog profiles ----------
    match /dogs/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.ownerUid == me()
        && request.resource.data.ownerUsername == get(/databases/$(database)/documents/users/$(me())).data.username
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.about is string && request.resource.data.about.size() <= 600
        && request.resource.data.photoUrls is list && request.resource.data.photoUrls.size() <= 6;
      allow delete: if signedIn() && uid == me();
    }

    // ---------- likes / passes ----------
    match /swipes/{id} {
      allow get: if signedIn() && inPair(id);
      allow list: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create, update: if signedIn()
        && request.resource.data.from == me()
        && id == me() + '_' + request.resource.data.to
        && request.resource.data.to != me()
        && request.resource.data.liked is bool
        && request.resource.data.keys().hasOnly(['from', 'to', 'liked', 'createdAt']);
      allow delete: if false;
    }

    // ---------- private chats ----------
    match /chats/{chatId} {
      allow get: if signedIn() && inPair(chatId);
      allow list: if signedIn() && me() in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'consent', 'lastMessage', 'updatedAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && me() in request.resource.data.members
        && chatId == pairId(request.resource.data.members[0], request.resource.data.members[1])
        && likes(request.resource.data.members[0], request.resource.data.members[1])
        && likes(request.resource.data.members[1], request.resource.data.members[0])
        && request.resource.data.consent.keys().hasOnly(request.resource.data.members)
        && request.resource.data.consent[request.resource.data.members[0]] == false
        && request.resource.data.consent[request.resource.data.members[1]] == false;

      // A member may flip ONLY their own consent, plus lastMessage/updatedAt.
      allow update: if signedIn() && me() in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consent', 'lastMessage', 'updatedAt'])
        && request.resource.data.consent.keys().hasOnly(resource.data.members)
        && request.resource.data.consent[otherOf(resource.data.members)] == resource.data.consent[otherOf(resource.data.members)]
        && request.resource.data.consent[me()] is bool;

      allow delete: if false;

      match /messages/{msgId} {
        allow read: if signedIn() && me() in get(chatPath(chatId)).data.members;
        allow create: if signedIn()
          && me() in get(chatPath(chatId)).data.members
          && request.resource.data.keys().hasOnly(['from', 'text', 'createdAt'])
          && request.resource.data.from == me()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }
  }
}
